# Environment configuration example for UMAT project
# Copy this file to .env and update the values before running locally or in production.

SPRING_DATASOURCE_URL=jdbc:h2:mem:umatdb;MODE=MYSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Backend server
SERVER_PORT=8080

# JWT configuration
APP_JWT_SECRET=replace-with-a-secure-32-byte-secret
APP_JWT_EXPIRATIONMS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Razorpay credentials (optional for billing integration)
RAZORPAY_KEY=replace-with-your-razorpay-key
RAZORPAY_SECRET=replace-with-your-razorpay-secret

# Deployment metadata (used by scripts and docs)
ACME_EMAIL=ops@example.com
VPS_HOST=your-remote-host.example
VPS_USER=deploy
VPS_PATH=/srv/rawfade

